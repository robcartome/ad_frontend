# URL base de la API Django REST Framework de apudig_mvp, incluida la versión.
NEXT_PUBLIC_API_V1_URL=http://127.0.0.1:8000/api/v1

# Dominio registrado en Django para el catálogo público. En producción puede
# omitirse para usar window.location.hostname; es útil para localhost/previews.
NEXT_PUBLIC_STOREFRONT_HOST=tolentino.localhost

# Variables exclusivas del servidor para resoluciÃ³n multiempresa.
APUDIG_API_V1_URL=http://127.0.0.1:8000/api/v1
APUDIG_CONTROL_HOSTS=localhost,apudig.vercel.app,web.apudig.com
APUDIG_ADMIN_ORIGIN=http://localhost:3000
STOREFRONT_REVALIDATE_SECRET=change-me-in-production
